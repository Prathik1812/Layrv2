# ============================================================================
# LAYR ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your keys
# ============================================================================

# 1. NVIDIA NIM API Key (Required for AI Product Discovery & Design Generation)
NVIDIA_API_KEY=nvapi-your-nvidia-api-key-here
NVIDIA_API_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.3-70b-instruct

# 2. Database Connection (Supabase Postgres or MySQL)
# Get your connection string from: Supabase Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. Supabase Project Credentials (Optional - for Supabase JS client & Storage)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Client-side Supabase variables (Prefix with VITE_)
VITE_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 4. Authentication & Security
JWT_SECRET=layr_super_secret_session_encryption_key_32_chars_min

# 5. Server Port
PORT=5000
NODE_ENV=development
